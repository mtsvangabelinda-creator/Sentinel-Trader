name: Run Tests

on:
  push:
    branches:
      - main
  pull_request:
  workflow_dispatch:  # Manual trigger

jobs:
  test:
    runs-on: ubuntu-latest
    
    steps:
      - uses: actions/checkout@v3
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      
      - name: Test 1 - Check all files exist
        run: |
          python << 'EOF'
          import os
          files = [
              'main.py', 'config/settings.py', 'config/btc_config.yaml',
              'engine/data_feed.py', 'engine/regime.py', 'engine/sentinel.py',
              'engine/risk_manager.py', 'engine/order_executor.py', 'engine/indicators.py',
              'strategies/base.py', 'strategies/trend_following.py', 'strategies/mean_reversion.py',
              'strategies/momentum_burst.py',
              'simulation/metrics.py', 'simulation/run_backtest.py',
              'optimizer/auto_optimizer.py', 'optimizer/shadow_runner.py', 
              'optimizer/promotion.py', 'optimizer/rollback.py',
              'monitoring/sqlite_logger.py', 'monitoring/telegram_alerts.py',
              'dashboard/generate.py'
          ]
          missing = [f for f in files if not os.path.exists(f)]
          if missing:
              print(f'❌ FAIL - Missing files: {missing}')
              exit(1)
          print('✅ PASS - All files present')
          EOF
      
      - name: Test 2 - Import all modules
        run: |
          python << 'EOF'
          try:
              from config.settings import load_config, load_env
              from engine.data_feed import DataFeed
              from engine.regime import RegimeClassifier
              from engine.sentinel import Sentinel
              from engine.risk_manager import RiskManager
              from engine.order_executor import OrderExecutor
              from strategies.trend_following import TrendFollowing
              from strategies.mean_reversion import MeanReversion
              from strategies.momentum_burst import MomentumBurst
              from monitoring.sqlite_logger import SQLiteLogger
              from monitoring.telegram_alerts import TelegramAlert
              from simulation.metrics import compute_metrics, compute_sharpe, max_drawdown
              from simulation.run_backtest import run_initial_backtest
              from optimizer.auto_optimizer import AutoOptimizer
              print('✅ PASS - All imports successful')
          except Exception as e:
              print(f'❌ FAIL - Import error: {e}')
              exit(1)
          EOF
      
      - name: Test 3 - Load and validate config
        run: |
          python << 'EOF'
          from config.settings import load_config
          config = load_config()
          
          checks = [
              ('mode' in config, 'Config has mode'),
              ('strategy_pools' in config, 'Strategy pools defined'),
              (config['max_concurrent_trades'] == 3, 'Max concurrent = 3'),
              (config['daily_loss_limit'] == 10.0, 'Daily loss limit = $10'),
              ('trend' in config['strategy_pools'], 'Trend pool defined'),
              ('meanrev' in config['strategy_pools'], 'MeanRev pool defined'),
              ('momentum' in config['strategy_pools'], 'Momentum pool defined'),
          ]
          
          all_pass = True
          for check, desc in checks:
              if check:
                  print(f'  ✅ {desc}')
              else:
                  print(f'  ❌ {desc}')
                  all_pass = False
          
          if all_pass:
              print('\n✅ PASS - Config valid')
          else:
              print('\n❌ FAIL - Config errors')
              exit(1)
          EOF
      
      - name: Test 4 - Validate YAML syntax
        run: |
          python << 'EOF'
          import yaml
          try:
              with open('config/btc_config.yaml', 'r') as f:
                  yaml.safe_load(f)
              print('✅ PASS - YAML syntax valid')
          except yaml.YAMLError as e:
              print(f'❌ FAIL - YAML error: {e}')
              exit(1)
          EOF
      
      - name: Test 5 - Database initialization
        run: |
          python << 'EOF'
          from monitoring.sqlite_logger import SQLiteLogger
          import sqlite3
          import os
          
          try:
              db_path = 'data/test_sentinel.db'
              db = SQLiteLogger(db_path)
              
              # Verify tables exist
              conn = sqlite3.connect(db_path)
              c = conn.cursor()
              c.execute("SELECT name FROM sqlite_master WHERE type='table'")
              tables = [row[0] for row in c.fetchall()]
              conn.close()
              
              required = ['trades', 'equity_snapshots', 'events', 'candles']
              missing = [t for t in required if t not in tables]
              
              os.remove(db_path)  # cleanup
              
              if missing:
                  print(f'❌ FAIL - Missing tables: {missing}')
                  exit(1)
              print('✅ PASS - Database initialized correctly')
          except Exception as e:
              print(f'❌ FAIL - DB error: {e}')
              exit(1)
          EOF
      
      - name: Test 6 - Risk Manager
        run: |
          python << 'EOF'
          from config.settings import load_config
          from engine.risk_manager import RiskManager
          from monitoring.sqlite_logger import SQLiteLogger
          
          config = load_config()
          db = SQLiteLogger('data/test_sentinel.db')
          risk = RiskManager(config, db)
          
          checks = [
              (risk.max_concurrent == 3, 'Max concurrent = 3'),
              (risk.daily_loss_limit == 10.0, 'Daily loss limit = $10'),
              (risk.can_open_position(), 'Can open position'),
          ]
          
          # Test position sizing
          size = risk.calculate_position_size(150, 39500, 40000)
          checks.append((size > 0, f'Position size calculated: {size:.8f} BTC'))
          
          all_pass = True
          for check, desc in checks:
              if check:
                  print(f'  ✅ {desc}')
              else:
                  print(f'  ❌ {desc}')
                  all_pass = False
          
          if all_pass:
              print('\n✅ PASS - Risk Manager works')
          else:
              print('\n❌ FAIL - Risk Manager errors')
              exit(1)
          EOF
      
      - name: Test 7 - Indicators
        run: |
          python << 'EOF'
          import numpy as np
          import pandas as pd
          from engine.indicators import atr, adx, rsi, bb
          
          # Generate test candles
          np.random.seed(42)
          n = 100
          prices = 40000 + np.cumsum(np.random.randn(n) * 50)
          highs = prices + np.abs(np.random.randn(n) * 20)
          lows = prices - np.abs(np.random.randn(n) * 20)
          
          candles = [[i, prices[i], highs[i], lows[i], prices[i], 1.0] for i in range(n)]
          
          checks = []
          
          # Test ATR
          atr_val = atr(candles, 14)
          checks.append((atr_val > 0, f'ATR calculated: {atr_val:.2f}'))
          
          # Test ADX
          df = pd.DataFrame(candles, columns=['t', 'o', 'h', 'l', 'c', 'v'])
          adx_val = adx(df, 14)
          checks.append((adx_val >= 0, f'ADX calculated: {adx_val:.2f}'))
          
          # Test RSI
          rsi_val = rsi(df, 14)
          checks.append((0 <= rsi_val <= 100, f'RSI calculated: {rsi_val:.2f}'))
          
          # Test BB
          bb_vals = bb(df, 20, 2)
          checks.append((bb_vals is not None, f'Bollinger Bands calculated'))
          
          all_pass = True
          for check, desc in checks:
              if check:
                  print(f'  ✅ {desc}')
              else:
                  print(f'  ❌ {desc}')
                  all_pass = False
          
          if all_pass:
              print('\n✅ PASS - Indicators work')
          else:
              print('\n❌ FAIL - Indicator errors')
              exit(1)
          EOF
      
      - name: Test 8 - Strategies
        run: |
          python << 'EOF'
          import numpy as np
          from config.settings import load_config
          from strategies.trend_following import TrendFollowing
          from strategies.mean_reversion import MeanReversion
          from strategies.momentum_burst import MomentumBurst
          
          config = load_config()
          
          # Generate test candles
          np.random.seed(42)
          n = 100
          prices = 40000 + np.cumsum(np.random.randn(n) * 50)
          highs = prices + np.abs(np.random.randn(n) * 20)
          lows = prices - np.abs(np.random.randn(n) * 20)
          
          candles_1m = [[i*60, prices[i], highs[i], lows[i], prices[i], 1.0] for i in range(n)]
          candles_5m = [[i*300, prices[i*5] if i*5 < n else prices[-1], 
                         highs[i*5] if i*5 < n else highs[-1], 
                         lows[i*5] if i*5 < n else lows[-1], 
                         prices[i*5] if i*5 < n else prices[-1], 5.0] for i in range(n//5)]
          ticker = {'bid': prices[-1] * 0.999, 'ask': prices[-1] * 1.001, 'last': prices[-1]}
          
          checks = []
          
          # Test Trend Following
          trend = TrendFollowing(config)
          checks.append((trend.is_active('trending'), 'Trend active in trending'))
          checks.append((not trend.is_active('ranging'), 'Trend inactive in ranging'))
          
          # Test Mean Reversion
          meanrev = MeanReversion(config)
          checks.append((meanrev.is_active('ranging'), 'MeanRev active in ranging'))
          checks.append((not meanrev.is_active('trending'), 'MeanRev inactive in trending'))
          
          # Test Momentum
          momentum = MomentumBurst(config)
          checks.append((momentum.is_active('trending'), 'Momentum always active (trending)'))
          checks.append((momentum.is_active('ranging'), 'Momentum always active (ranging)'))
          
          all_pass = True
          for check, desc in checks:
              if check:
                  print(f'  ✅ {desc}')
              else:
                  print(f'  ❌ {desc}')
                  all_pass = False
          
          if all_pass:
              print('\n✅ PASS - Strategies initialized')
          else:
              print('\n❌ FAIL - Strategy errors')
              exit(1)
          EOF
      
      - name: Test 9 - Metrics
        run: |
          python << 'EOF'
          import numpy as np
          from simulation.metrics import compute_sharpe, max_drawdown, profit_factor, win_rate
          
          # Create sample trades
          returns = [10, -5, 15, 20, -3, 25, 30, -10, 12, 8]
          
          checks = []
          
          sharpe = compute_sharpe(returns)
          checks.append((sharpe > 0, f'Sharpe calculated: {sharpe:.2f}'))
          
          equity = [350 + sum(returns[:i+1]) for i in range(len(returns))]
          dd = max_drawdown(equity)
          checks.append((0 <= dd <= 1, f'Max drawdown calculated: {dd:.2%}'))
          
          trades = [{'pnl': r} for r in returns]
          pf = profit_factor(trades)
          checks.append((pf > 0, f'Profit factor calculated: {pf:.2f}'))
          
          wr = win_rate(trades)
          checks.append((0 <= wr <= 1, f'Win rate calculated: {wr:.2%}'))
          
          all_pass = True
          for check, desc in checks:
              if check:
                  print(f'  ✅ {desc}')
              else:
                  print(f'  ❌ {desc}')
                  all_pass = False
          
          if all_pass:
              print('\n✅ PASS - Metrics calculated correctly')
          else:
              print('\n❌ FAIL - Metrics errors')
              exit(1)
          EOF
      
      - name: Test 10 - Environment variables
        run: |
          python << 'EOF'
          from config.settings import load_env
          env = load_env()
          
          # These won't be set in CI, but should load without error
          checks = [
              (isinstance(env, dict), 'Environment loaded as dict'),
              ('KRAKEN_API_KEY' in env, 'KRAKEN_API_KEY key exists'),
              ('TELEGRAM_TOKEN' in env, 'TELEGRAM_TOKEN key exists'),
          ]
          
          all_pass = True
          for check, desc in checks:
              if check:
                  print(f'  ✅ {desc}')
              else:
                  print(f'  ❌ {desc}')
                  all_pass = False
          
          if all_pass:
              print('\n✅ PASS - Environment loading works')
          else:
              print('\n❌ FAIL - Environment errors')
              exit(1)
          EOF
      
      - name: Summary
        if: always()
        run: |
          echo ""
          echo "╔════════════════════════════════════════╗"
          echo "║   SENTINELTRADER TEST SUITE COMPLETE   ║"
          echo "╚════════════════════════════════════════╝"
          echo ""
          echo "✅ All tests passed - ready for deployment!"
